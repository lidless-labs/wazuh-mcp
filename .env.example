WAZUH_URL=https://localhost:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=wazuh-wui
WAZUH_VERIFY_SSL=true
# Opt out only for trusted self-signed lab environments. Prefer WAZUH_CA_FILE.
# WAZUH_VERIFY_SSL=false
# PEM CA bundle used to verify the manager certificate (private CA / self-signed).
# WAZUH_CA_FILE=/etc/wazuh-mcp/manager-ca.pem
# Plain http:// URLs are rejected unless this is true (trusted lab networks only).
# WAZUH_ALLOW_INSECURE_HTTP=false
WAZUH_TIMEOUT=30
WAZUH_MCP_MAX_RESPONSE_BYTES=250000
WAZUH_MCP_MAX_STDIO_BUFFER_BYTES=8388608

# Optional, required for alert tools and the wazuh://alerts/recent resource.
# When WAZUH_INDEXER_URL is set, WAZUH_INDEXER_PASSWORD is required too;
# the server fails fast at startup instead of sending an empty password.
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=admin
WAZUH_INDEXER_VERIFY_SSL=true
# Opt out only for trusted self-signed lab environments. Prefer WAZUH_INDEXER_CA_FILE.
# WAZUH_INDEXER_VERIFY_SSL=false
# WAZUH_INDEXER_CA_FILE=/etc/wazuh-mcp/indexer-ca.pem
WAZUH_INDEXER_TIMEOUT=30
